{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with account settings, plan, and credit balance",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 128
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to the user avatar",
          "maxLength": 1024
        },
        "plan": {
          "type": "string",
          "description": "Subscription tier",
          "enum": ["FREE", "PRO", "BUSINESS", "TRIAL_7_DAYS", "MONTHLY_19_99", "YEARLY_199_99"]
        },
        "creditsRemaining": {
          "type": "number",
          "description": "Remaining AI generation credits"
        },
        "creditsUsed": {
          "type": "number",
          "description": "Total credits used"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the account was initialized"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last profile update"
        }
      },
      "required": ["email", "name", "plan", "creditsRemaining"]
    },
    "Design": {
      "title": "Design",
      "description": "Generated logo, image, vector art, or visual asset",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Name or title of the design",
          "maxLength": 160
        },
        "type": {
          "type": "string",
          "description": "Design modality or asset type",
          "enum": ["logo", "image", "brand_kit", "social", "product", "banner", "video"]
        },
        "prompt": {
          "type": "string",
          "description": "Prompt used to synthesize the design",
          "maxLength": 2000
        },
        "enhancedPrompt": {
          "type": "string",
          "description": "Rudra or LLM enhanced generation prompt",
          "maxLength": 3000
        },
        "url": {
          "type": "string",
          "description": "URL to the rendered image or raster preview",
          "maxLength": 2048
        },
        "svgCode": {
          "type": "string",
          "description": "Raw SVG XML vector code",
          "maxLength": 500000
        },
        "aspectRatio": {
          "type": "string",
          "description": "Aspect ratio format",
          "maxLength": 32
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether the design is marked as favorite"
        },
        "projectId": {
          "type": "string",
          "description": "Associated project ID if organized in a folder",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "title", "type", "prompt", "url"]
    },
    "Project": {
      "title": "Project",
      "description": "Organizing workspace folder for grouping design assets",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Project title",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Project description or brand context",
          "maxLength": 500
        },
        "brandKitId": {
          "type": "string",
          "description": "Associated Brand Kit ID",
          "maxLength": 128
        },
        "itemsCount": {
          "type": "number",
          "description": "Number of assets inside this project"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether project is archived"
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether project is pinned or favorited"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "name"]
    },
    "BrandKit": {
      "title": "BrandKit",
      "description": "Complete corporate brand guidelines, color palettes, and typography rules",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Brand Kit Name",
          "maxLength": 120
        },
        "industry": {
          "type": "string",
          "description": "Target commercial industry",
          "maxLength": 120
        },
        "tagline": {
          "type": "string",
          "description": "Brand slogan or tagline",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Brand identity summary",
          "maxLength": 800
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this brand kit is the primary active default"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "name", "industry"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin privileges and role verification record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "description": "Admin role level",
          "enum": ["superadmin", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Admin assignment timestamp"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with plan, credits, and display details"
    },
    "/users/{userId}/designs/{designId}": {
      "schema": "Design",
      "description": "User generated logos, vector graphics, and synthesized images"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Folders and project collections for organizing assets"
    },
    "/users/{userId}/brandKits/{brandKitId}": {
      "schema": "BrandKit",
      "description": "Corporate visual identities, typography, and color systems"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Trusted collection of verified system administrators"
    }
  }
}
